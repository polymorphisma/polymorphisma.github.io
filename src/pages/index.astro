---
import Base from '../layouts/Base.astro';
import '../styles/global.css';

const projects = [
  {
    name: 'Mavefund',
    url: 'https://mavefund.com',
    image: '/image/mavefund.png',
    description:
      'Encompassing platform providing free fundamental data, stock screener dashboard, AI-powered market projections and portfolio allocation capable of outperforming the market.',
    tags: ['FastAPI', 'PostgreSQL', 'JavaScript'],
  },
  {
    name: 'Nepse Scraper',
    url: 'https://github.com/polymorphisma',
    image: '/image/nepse.jpeg',
    description:
      'Python module providing convenient access to the Nepal Stock Exchange (NEPSE) API, enabling developers and analysts to retrieve stock market data.',
    tags: ['Python', 'Web Scraping', 'PyPI'],
  },
];
---

<Base title="Shrawan Sunar">
  <!-- NAV -->
  <nav class="fixed top-0 left-0 right-0 z-50 border-b border-border bg-bg/80 backdrop-blur-sm">
    <div class="max-w-3xl mx-auto px-6 h-12 flex items-center justify-between">
      <span class="font-mono text-sm text-muted" id="nav-section">~/home</span>
      <div class="flex gap-5 text-sm text-muted">
        <a href="#about" class="hover:text-text transition-colors">about</a>
        <a href="#projects" class="hover:text-text transition-colors">projects</a>
        <a href="/blog" class="hover:text-text transition-colors">blog</a>
        <a href="/cli" class="hover:text-text transition-colors">cli</a>
      </div>
    </div>
  </nav>

  <main class="max-w-3xl mx-auto px-6 pt-28 pb-24 space-y-28">

    <!-- HERO -->
    <section id="about" class="animate-fade-in">
      <div class="flex flex-col sm:flex-row sm:items-center gap-8">
        <img
          src="/image/me_2.jpg"
          alt="Shrawan Sunar"
          class="w-20 h-20 rounded-full object-cover ring-2 ring-border shrink-0"
        />
        <div>
          <h1 class="text-2xl font-semibold text-text">Shrawan Sunar</h1>
          <p class="text-muted mt-1 font-mono text-sm">
            Computer Science Student · Developer · ML Enthusiast
          </p>
        </div>
      </div>

      <p class="mt-6 text-[#aaaaaa] leading-relaxed">
        Self-taught developer passionate about building things — from stock market tools and Python
        packages to terminal-style interfaces. Currently studying CS and exploring the intersection
        of software and finance.
      </p>

      <div class="flex flex-wrap gap-3 mt-6">
        <a
          href="/files/resume.pdf"
          download
          class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-surface border border-border rounded-md hover:border-accent hover:text-accent transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><path d="M21 15v4a2 2 0 0 1-2 2H5a2 2 0 0 1-2-2v-4"/><polyline points="7 10 12 15 17 10"/><line x1="12" y1="15" x2="12" y2="3"/></svg>
          Resume
        </a>
        <a
          href="mailto:shrawansunar.6@gmail.com"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-surface border border-border rounded-md hover:border-accent hover:text-accent transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round"><rect x="2" y="4" width="20" height="16" rx="2"/><path d="m22 7-8.97 5.7a1.94 1.94 0 0 1-2.06 0L2 7"/></svg>
          Email
        </a>
        <a
          href="https://github.com/polymorphisma"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-surface border border-border rounded-md hover:border-accent hover:text-accent transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M12 0C5.37 0 0 5.373 0 12c0 5.303 3.438 9.8 8.207 11.387.6.11.793-.26.793-.577v-2.234c-3.338.726-4.033-1.416-4.033-1.416-.546-1.387-1.333-1.756-1.333-1.756-1.089-.744.083-.729.083-.729 1.205.084 1.84 1.237 1.84 1.237 1.07 1.834 2.807 1.304 3.492.997.108-.775.418-1.305.762-1.604-2.665-.305-5.467-1.334-5.467-5.93 0-1.31.469-2.38 1.236-3.22-.124-.303-.535-1.524.117-3.176 0 0 1.008-.322 3.301 1.23A11.509 11.509 0 0 1 12 5.803c1.02.005 2.047.138 3.006.404 2.291-1.552 3.297-1.23 3.297-1.23.653 1.653.242 2.874.118 3.176.77.84 1.235 1.91 1.235 3.22 0 4.61-2.807 5.625-5.479 5.92.43.372.823 1.102.823 2.222v3.293c0 .319.192.694.801.576C20.566 21.797 24 17.3 24 12c0-6.627-5.373-12-12-12z"/></svg>
          GitHub
        </a>
        <a
          href="https://www.linkedin.com/in/shrawansunar/"
          target="_blank"
          rel="noopener"
          class="inline-flex items-center gap-2 px-4 py-2 text-sm bg-surface border border-border rounded-md hover:border-accent hover:text-accent transition-all"
        >
          <svg xmlns="http://www.w3.org/2000/svg" width="14" height="14" viewBox="0 0 24 24" fill="currentColor"><path d="M20.447 20.452h-3.554v-5.569c0-1.328-.027-3.037-1.852-3.037-1.853 0-2.136 1.445-2.136 2.939v5.667H9.351V9h3.414v1.561h.046c.477-.9 1.637-1.85 3.37-1.85 3.601 0 4.267 2.37 4.267 5.455v6.286zM5.337 7.433a2.062 2.062 0 0 1-2.063-2.065 2.064 2.064 0 1 1 2.063 2.065zm1.782 13.019H3.555V9h3.564v11.452zM22.225 0H1.771C.792 0 0 .774 0 1.729v20.542C0 23.227.792 24 1.771 24h20.451C23.2 24 24 23.227 24 22.271V1.729C24 .774 23.2 0 22.222 0h.003z"/></svg>
          LinkedIn
        </a>
      </div>
    </section>

    <!-- PROJECTS -->
    <section id="projects" class="animate-slide-up" style="animation-delay: 0.2s; opacity: 0;">
      <h2 class="text-xs font-mono uppercase tracking-widest text-muted mb-6">Projects</h2>
      <div class="space-y-4">
        {projects.map((p) => (
          <a
            href={p.url}
            target="_blank"
            rel="noopener"
            class="block group bg-surface border border-border rounded-lg overflow-hidden hover:border-accent/50 transition-all duration-200"
          >
            <div class="flex gap-4 p-4">
              <img
                src={p.image}
                alt={p.name}
                class="w-16 h-16 rounded object-cover shrink-0 opacity-80 group-hover:opacity-100 transition-opacity"
              />
              <div class="min-w-0">
                <h3 class="font-medium text-text group-hover:text-accent transition-colors">{p.name}</h3>
                <p class="text-sm text-muted mt-1 leading-relaxed line-clamp-2">{p.description}</p>
                <div class="flex flex-wrap gap-1.5 mt-2">
                  {p.tags.map((tag) => (
                    <span class="text-xs px-2 py-0.5 bg-bg border border-border rounded text-muted font-mono">
                      {tag}
                    </span>
                  ))}
                </div>
              </div>
            </div>
          </a>
        ))}
      </div>
    </section>

    <!-- GITHUB CONTRIBUTIONS -->
    <section class="animate-slide-up" style="animation-delay: 0.3s; opacity: 0;">
      <h2 class="text-xs font-mono uppercase tracking-widest text-muted mb-4">GitHub Activity</h2>
      <div class="bg-surface border border-border rounded-lg p-4 overflow-x-auto">
        <img
          src="https://ghchart.rshah.org/a8a8ff/polymorphisma"
          alt="GitHub contribution chart"
          class="w-full min-w-[600px]"
        />
      </div>
    </section>

  </main>

  <!-- FOOTER -->
  <footer class="border-t border-border">
    <div class="max-w-3xl mx-auto px-6 h-12 flex items-center justify-between text-xs text-muted font-mono">
      <span>shrawan sunar</span>
      <div class="flex gap-4">
        <a href="/blog" class="hover:text-text transition-colors">blog</a>
        <a href="/cli" class="hover:text-text transition-colors">cli</a>
      </div>
    </div>
  </footer>

  <script>
    // Update nav section label on scroll
    const sections = document.querySelectorAll<HTMLElement>('section[id]');
    const navSection = document.getElementById('nav-section');

    const observer = new IntersectionObserver(
      (entries) => {
        entries.forEach((entry) => {
          if (entry.isIntersecting && navSection) {
            navSection.textContent = `~/${entry.target.id}`;
          }
        });
      },
      { threshold: 0.4 }
    );

    sections.forEach((s) => observer.observe(s));

    // Trigger slide-up animations
    document.querySelectorAll<HTMLElement>('.animate-slide-up').forEach((el) => {
      el.style.animation = 'slideUp 0.5s ease forwards';
    });
  </script>
</Base>
